# ── LLM: Google Gemini (AI Studio — capa gratuita) ─────────────────────────────
# Obtén tu API key en https://aistudio.google.com/apikey (suelen iniciar con "AIza...")
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_MODEL_CHEAP=gemini-2.5-flash-lite

# ── RAG / Embeddings (gratis) ──────────────────────────────────────────────────
# "gemini" = embeddings via AI Studio free tier (sin descarga)
# "local"  = sentence-transformers offline (requiere: pip install sentence-transformers)
EMBEDDING_PROVIDER=gemini

# ── PostgreSQL + pgvector ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://icesi:icesi_pass@localhost:5432/icesi_ia

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── WhatsApp Cloud API ─────────────────────────────────────────────────────────
WHATSAPP_PHONE_ID=...
WHATSAPP_ACCESS_TOKEN=...
WHATSAPP_APP_SECRET=...        # Meta App Secret — required for webhook signature verification in production
WHATSAPP_VERIFY_TOKEN=icesi_verify_2026

# ── CRM Adapter ───────────────────────────────────────────────────────────────
# "mock" | "hubspot" | "salesforce" | "sheets"
CRM_BACKEND=mock
HUBSPOT_API_KEY=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# ── Seguridad ─────────────────────────────────────────────────────────────────
SECRET_KEY=cambia_esto_en_produccion_32chars_min   # MUST change — used as HMAC salt for phone hashes
ENCRYPTION_KEY=cambia_esto_en_produccion_32chars_min
CHAT_API_KEY=                                       # Bearer token for /chat endpoint — required in production

# ── WhatsApp grupo interno asesores ───────────────────────────────────────────
INTERNAL_WA_GROUP_PREGRADO=...
INTERNAL_WA_GROUP_POSGRADO=...
INTERNAL_WA_GROUP_EDUCONTINUA=...
INTERNAL_WA_GROUP_JEFE=...

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
KB_PATH=./icesi-kb
